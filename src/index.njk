<section class="section section-alt" id="scenarios">
  <div class="container">
    <header class="section-head">
      <h2>快连常见使用场景</h2>
    </header>
    <div class="scenario-grid">
      {% set scenarios = [
        ["办公远程", "稳定连接公司内网与协作工具，减少断线重连次数。"],
        ["跨境浏览", "切换合适线路，提升海外网站与服务的访问流畅度。"],
        ["游戏加速", "选择低延迟节点，降低丢包与卡顿现象。"],
        ["流媒体", "针对观影平台选择专用线路，减少缓冲等待。"],
        ["多设备", "手机、平板与电脑共享账号，统一管理连接状态。"],
        ["校园网络", "在受限网络环境下完成连接与分流配置。"],
        ["出差旅行", "海外接入时快速切换当地可用节点。"],
        ["自动重连", "断线后自动恢复，减少手动操作。"]
      ] %}
      {% for item in scenarios %}
        <article class="scenario-item">
          <span class="scenario-dot"></span>
          <div>
            <h3>{{ item[0] }}</h3>
            <p>{{ item[1] }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" id="latest">
