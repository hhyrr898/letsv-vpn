    <div class="magazine-grid">
      {% for post in collections.posts | sortByDateDesc %}
        {% if loop.index <= 12 %}
          <article class="mag-card {% if loop.index == 1 %}mag-featured{% elif loop.index <= 4 %}mag-medium{% else %}mag-compact{% endif %}">
            {% if post.data.heroImage %}
              <a class="mag-thumb" href="{{ post.url }}">
                <img src="{{ post.data.heroImage }}" alt="{{ post.data.heroAlt or post.data.title }}" loading="lazy">
              </a>
            {% endif %}
            <div class="mag-body">
              <time datetime="{{ post.date | readableDate }}">{{ post.date | readableDate }}</time>
              <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
              <p>{{ post.data.description }}</p>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

